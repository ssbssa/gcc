--- mingw-w64-crt/misc/stpcpy.c	(revision 0)
+++ mingw-w64-crt/misc/stpcpy.c	(working copy)
@@ -0,0 +1,10 @@
+#define __CRT__NO_INLINE
+#include <string.h>
+
+char * __cdecl stpcpy (char * __restrict__ _Dest,const char * __restrict__ _Source)
+{
+  for (; *_Source; _Source++, _Dest++)
+    *_Dest = *_Source;
+  *_Dest = '\0';
+  return _Dest;
+}
