diff --git a/mingw-w64-crt/misc/stpcpy.c b/mingw-w64-crt/misc/stpcpy.c
new file mode 100644
index 000000000..f8584d298
--- /dev/null
+++ b/mingw-w64-crt/misc/stpcpy.c
@@ -0,0 +1,10 @@
+#define __CRT__NO_INLINE
+#include <string.h>
+
+char * __cdecl stpcpy (char * __restrict__ _Dest,const char * __restrict__ _Source)
+{
+  for (; *_Source; _Source++, _Dest++)
+    *_Dest = *_Source;
+  *_Dest = '\0';
+  return _Dest;
+}
