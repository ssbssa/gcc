From 0a242dea770425eb22a924252e6107e91f496e6e Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Mon, 2 May 2016 19:31:51 +0200
Subject: [PATCH 7/9] fix printf out of bounds access

If the precision is specified, no more than that many bytes are written.
---
 mingw-w64-crt/stdio/mingw_pformat.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mingw-w64-crt/stdio/mingw_pformat.c b/mingw-w64-crt/stdio/mingw_pformat.c
index 25ceffb50..af50a2344 100644
--- a/mingw-w64-crt/stdio/mingw_pformat.c
+++ b/mingw-w64-crt/stdio/mingw_pformat.c
@@ -538,7 +538,7 @@ void __pformat_putchars( const char *s, int count, __pformat_t *stream )
       mbstate_t ps = {0};
       --count;
       p = &w[0];
-      l = mbrtowc (p, s, strlen (s), &ps);
+      l = mbrtowc (p, s, MB_CUR_MAX, &ps);
       if (!l)
         break;
       if ((ssize_t)l < 0)
-- 
2.53.0

