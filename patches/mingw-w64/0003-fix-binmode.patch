From f8e41d1a9ed70959bbe12fa80a236f8c317f2bbf Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sat, 29 Aug 2015 15:31:46 +0200
Subject: [PATCH 3/9] fix binmode

---
 mingw-w64-crt/crt/binmode.c |  5 ++++-
 mingw-w64-crt/crt/crtexe.c  | 11 +++++++++++
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/mingw-w64-crt/crt/binmode.c b/mingw-w64-crt/crt/binmode.c
index 18b15d1ba..2e46c2fdf 100644
--- a/mingw-w64-crt/crt/binmode.c
+++ b/mingw-w64-crt/crt/binmode.c
@@ -5,4 +5,7 @@
  */
 
 #include <fcntl.h>
-#include <stdlib.h>
+
+/* Set default file mode to binary */
+
+int _fmode = _O_BINARY;
diff --git a/mingw-w64-crt/crt/crtexe.c b/mingw-w64-crt/crt/crtexe.c
index 6e19ce75b..97aa9a290 100644
--- a/mingw-w64-crt/crt/crtexe.c
+++ b/mingw-w64-crt/crt/crtexe.c
@@ -15,6 +15,7 @@
 #include <locale.h>
 #include <float.h>
 #include <corecrt_startup.h>
+#include <fcntl.h>
 
 #if defined(__SEH__) && (!defined(__clang__) || __clang_major__ >= 7)
 #define SEH_INLINE_ASM
@@ -206,6 +207,16 @@ __tmainCRTStartup (void)
 	else
 	  __set_app_type (_CONSOLE_APP);
 
+	if (_fmode == _O_BINARY)
+	  {
+	    if (stdin)
+	      _setmode (stdin->_file, _O_BINARY);
+	    if (stdout)
+	      _setmode (stdout->_file, _O_BINARY);
+	    if (stderr)
+	      _setmode (stderr->_file, _O_BINARY);
+	  }
+
 	*__p__fmode () = _fmode;
 	*__p__commode () = _commode;
 
-- 
2.53.0

