From 4bd42bc747a51fc9767a1490f26719d8226f78e7 Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sat, 29 Aug 2015 16:03:07 +0200
Subject: [PATCH 07/11] free argv[]

---
 mingw-w64-crt/crt/crtexe.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/mingw-w64-crt/crt/crtexe.c b/mingw-w64-crt/crt/crtexe.c
index 0b82fba37..b92c077b3 100644
--- a/mingw-w64-crt/crt/crtexe.c
+++ b/mingw-w64-crt/crt/crtexe.c
@@ -87,6 +87,7 @@ DWORD __mingw_winmain_nShowCmd = SW_SHOWDEFAULT;
 static int argc;
 extern void __main(void);
 static _TCHAR **argv;
+static _TCHAR **argv_copy;
 static _TCHAR **envp;
 
 static int argret;
@@ -329,6 +330,8 @@ __tmainCRTStartup (void)
 				    StartupInfo.wShowWindow : SW_SHOWDEFAULT;
       }
     duplicate_ppstrings (argc, &argv);
+    argv_copy = (_TCHAR **) malloc (sizeof (_TCHAR *) * argc);
+    memcpy (argv_copy, argv, sizeof (_TCHAR *) * argc);
     __main ();
 #ifdef WPRFLAG
     __winitenv = envp;
@@ -341,6 +344,13 @@ __tmainCRTStartup (void)
 #endif
     mainret = main (argc, argv, envp);
 #endif
+    {
+      int i;
+      for (i=0; i < argc; i++)
+        free (argv_copy[i]);
+      free (argv_copy);
+      free (argv);
+    }
     if (!managedapp)
       exit (mainret);
 
-- 
