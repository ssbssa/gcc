From 78efefb7363a8e9246eedde6d933bd22bc5aee99 Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sat, 29 Aug 2015 16:03:07 +0200
Subject: [PATCH 7/7] free argv[]

---
 mingw-w64-crt/crt/crtexe.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/mingw-w64-crt/crt/crtexe.c b/mingw-w64-crt/crt/crtexe.c
index 2c04304..973b06b 100644
--- a/mingw-w64-crt/crt/crtexe.c
+++ b/mingw-w64-crt/crt/crtexe.c
@@ -77,6 +77,7 @@ DWORD __mingw_winmain_nShowCmd = SW_SHOWDEFAULT;
 static int argc;
 extern void __main(void);
 static _TCHAR **argv;
+static _TCHAR **argv_copy;
 static _TCHAR **envp;
 
 static int argret;
@@ -330,6 +331,8 @@ __tmainCRTStartup (void)
 				    StartupInfo.wShowWindow : SW_SHOWDEFAULT;
       }
     duplicate_ppstrings (argc, &argv);
+    argv_copy = (_TCHAR **) malloc (sizeof (_TCHAR *) * argc);
+    memcpy (argv_copy, argv, sizeof (_TCHAR *) * argc);
     __main ();
 #ifdef WPRFLAG
     __winitenv = envp;
@@ -340,6 +343,13 @@ __tmainCRTStartup (void)
     __initenv = envp;
     mainret = main (argc, argv, envp);
 #endif
+    {
+      int i;
+      for (i=0; i < argc; i++)
+        free (argv_copy[i]);
+      free (argv_copy);
+      free (argv);
+    }
     if (!managedapp)
       exit (mainret);
 
