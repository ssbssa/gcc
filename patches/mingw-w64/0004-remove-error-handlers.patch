From 182da2094adc0fb215b05128c2392b84ce15e63f Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sat, 29 Aug 2015 15:33:16 +0200
Subject: [PATCH 4/9] remove error handlers

---
 mingw-w64-crt/crt/crtexe.c       | 6 ++++++
 mingw-w64-crt/crt/pseudo-reloc.c | 4 ++++
 2 files changed, 10 insertions(+)

diff --git a/mingw-w64-crt/crt/crtexe.c b/mingw-w64-crt/crt/crtexe.c
index 97aa9a290..f4ad70cfe 100644
--- a/mingw-w64-crt/crt/crtexe.c
+++ b/mingw-w64-crt/crt/crtexe.c
@@ -58,6 +58,7 @@ extern void _pei386_runtime_relocator (void);
 long CALLBACK _gnu_exception_handler (EXCEPTION_POINTERS * exception_data);
 static int duplicate_ppstrings (int ac, _TCHAR ***av);
 
+#if 0
 extern int _MINGW_INSTALL_DEBUG_MATHERR;
 
 #ifdef __MINGW_SHOW_INVALID_PARAMETER_EXCEPTION
@@ -77,6 +78,7 @@ __mingw_invalidParameterHandler (const wchar_t * __UNUSED_PARAM_1(expression),
   wprintf(L"Expression: %s\n", expression);
 #endif
 }
+#endif
 
 static void
 safe_flush (void)
@@ -198,7 +200,9 @@ __tmainCRTStartup (void)
 	__mingw_init_ehandler ();
 #endif
 	__mingw_oldexcpt_handler = SetUnhandledExceptionFilter (_gnu_exception_handler);
+#if 0
 	_set_invalid_parameter_handler (__mingw_invalidParameterHandler);
+#endif
 	_fpreset ();
 
 	managedapp = check_managed_app ();
@@ -228,8 +232,10 @@ __tmainCRTStartup (void)
 	if (ret < 0)
 	  _amsg_exit (8); /* _RT_SPACEARG */
 
+#if 0
 	if (_MINGW_INSTALL_DEBUG_MATHERR == 1)
 	  __setusermatherr (_matherr);
+#endif
 
 	if (__globallocalestatus == -1)
 	  _configthreadlocale (-1);
diff --git a/mingw-w64-crt/crt/pseudo-reloc.c b/mingw-w64-crt/crt/pseudo-reloc.c
index dd08e718a..00180bf0c 100644
--- a/mingw-w64-crt/crt/pseudo-reloc.c
+++ b/mingw-w64-crt/crt/pseudo-reloc.c
@@ -80,6 +80,9 @@ typedef struct {
   DWORD version;
 } runtime_pseudo_reloc_v2;
 
+#if 1
+#define __report_error(a...) abort()
+#else
 static void ATTRIBUTE_NORETURN
 __report_error (const char *msg, ...)
 {
@@ -156,6 +159,7 @@ __report_error (const char *msg, ...)
   abort ();
 #endif
 }
+#endif
 
 /* For mingw-w64 we have additional helpers to get image information
    on runtime.  This allows us to cache for pseudo-relocation pass
-- 
2.53.0

