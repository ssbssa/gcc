diff --git a/mingw-w64-crt/misc/strndup.c b/mingw-w64-crt/misc/strndup.c
new file mode 100644
index 000000000..c3b455028
--- /dev/null
+++ b/mingw-w64-crt/misc/strndup.c
@@ -0,0 +1,15 @@
+#define __CRT__NO_INLINE
+#include <string.h>
+#include <stdlib.h>
+
+char *__cdecl strndup(const char *_Str,size_t _MaxCount)
+{
+  size_t len = strnlen(_Str, _MaxCount);
+  char *copy = malloc(len + 1);
+  if (copy)
+  {
+    memcpy(copy, _Str, len);
+    copy[len] = 0;
+  }
+  return copy;
+}
diff --git a/mingw-w64-crt/misc/wcsndup.c b/mingw-w64-crt/misc/wcsndup.c
new file mode 100644
index 000000000..adba07cf4
--- /dev/null
+++ b/mingw-w64-crt/misc/wcsndup.c
@@ -0,0 +1,15 @@
+#define __CRT__NO_INLINE
+#include <string.h>
+#include <stdlib.h>
+
+wchar_t *__cdecl wcsndup(const wchar_t *_Str,size_t _MaxCount)
+{
+  size_t len = wcsnlen(_Str, _MaxCount);
+  wchar_t *copy = malloc((len + 1) * sizeof(wchar_t));
+  if (copy)
+  {
+    memcpy(copy, _Str, len * sizeof(wchar_t));
+    copy[len] = 0;
+  }
+  return copy;
+}
