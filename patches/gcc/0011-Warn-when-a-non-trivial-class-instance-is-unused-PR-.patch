From 22fdefbe4a0b4a15cf87d4f563d56849e66cd33b Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sun, 28 Mar 2021 15:13:14 +0200
Subject: [PATCH 11/17] Warn when a non-trivial class instance is unused (PR
 c++/60212)

---
 gcc/common.opt | 4 ++++
 gcc/cp/decl.cc | 2 ++
 gcc/cp/init.cc | 1 +
 3 files changed, 7 insertions(+)

diff --git a/gcc/common.opt b/gcc/common.opt
index ce0cfd82a93..dde45813f9f 100644
--- a/gcc/common.opt
+++ b/gcc/common.opt
@@ -841,6 +841,10 @@ Wunused-label
 Common Var(warn_unused_label) Warning EnabledBy(Wunused)
 Warn when a label is unused.
 
+Wunused-non-trivial
+Common Var(warn_unused_non_trivial) Warning
+Warn when a non-trivial class instance is unused.
+
 Wunused-parameter
 Common Var(warn_unused_parameter) Warning EnabledBy(Wunused && Wextra)
 Warn when a function parameter is unused.
diff --git a/gcc/cp/decl.cc b/gcc/cp/decl.cc
index 878b14fe771..4006a423bec 100644
--- a/gcc/cp/decl.cc
+++ b/gcc/cp/decl.cc
@@ -678,6 +678,7 @@ poplevel (int keep, int reverse, int functionbody)
 		: (DECL_NAME (decl) && !DECL_ARTIFICIAL (decl)))
 	    && type != error_mark_node
 	    && (!CLASS_TYPE_P (type)
+		|| warn_unused_non_trivial
 		|| !TYPE_HAS_NONTRIVIAL_DESTRUCTOR (type)
 		|| lookup_attribute ("warn_unused",
 				     TYPE_ATTRIBUTES (TREE_TYPE (decl)))))
@@ -18415,6 +18416,7 @@ cxx_maybe_build_cleanup (tree decl, tsubst_flags_t complain)
 
   if (cleanup
       && DECL_P (decl)
+      && !warn_unused_non_trivial
       && !lookup_attribute ("warn_unused", TYPE_ATTRIBUTES (TREE_TYPE (decl)))
       /* Treat objects with destructors as used; the destructor may do
 	 something substantive.  */
diff --git a/gcc/cp/init.cc b/gcc/cp/init.cc
index a0a28f2a002..8ad0daeaca6 100644
--- a/gcc/cp/init.cc
+++ b/gcc/cp/init.cc
@@ -2052,6 +2052,7 @@ build_aggr_init (tree exp, tree init, int flags, tsubst_flags_t complain)
 
   if ((VAR_P (exp) || TREE_CODE (exp) == PARM_DECL)
       && TREE_SIDE_EFFECTS (stmt_expr)
+      && !warn_unused_non_trivial
       && !lookup_attribute ("warn_unused", TYPE_ATTRIBUTES (type)))
     /* Just know that we've seen something for this node.  */
     TREE_USED (exp) = 1;
-- 
