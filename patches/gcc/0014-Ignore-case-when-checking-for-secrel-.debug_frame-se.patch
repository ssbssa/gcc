From a0dc48e97b1615cda765fc92277da7ce16ad785f Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sun, 2 May 2021 16:07:05 +0200
Subject: [PATCH 14/17] Ignore case when checking for secrel .debug_frame
 section (PR debug/100383)

---
 gcc/configure    | 2 +-
 gcc/configure.ac | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/gcc/configure b/gcc/configure
index f697874f2d8..657112b3abd 100755
--- a/gcc/configure
+++ b/gcc/configure
@@ -24717,7 +24717,7 @@ else
     gcc_cv_as_cfi_sections_directive=no
     if test "x$gcc_cv_objdump" != x; then
      if $gcc_cv_objdump -j .debug_frame -r conftest.o 2>/dev/null | \
-	grep secrel > /dev/null; then
+	grep -i secrel > /dev/null; then
       gcc_cv_as_cfi_sections_directive=yes
      fi
     fi
diff --git a/gcc/configure.ac b/gcc/configure.ac
index fec897c2c08..073884d56b8 100644
--- a/gcc/configure.ac
+++ b/gcc/configure.ac
@@ -3346,7 +3346,7 @@ gcc_GAS_CHECK_FEATURE([cfi sections directive],
     gcc_cv_as_cfi_sections_directive=no
     if test "x$gcc_cv_objdump" != x; then
      if $gcc_cv_objdump -j .debug_frame -r conftest.o 2>/dev/null | \
-	grep secrel > /dev/null; then
+	grep -i secrel > /dev/null; then
       gcc_cv_as_cfi_sections_directive=yes
      fi
     fi
-- 
