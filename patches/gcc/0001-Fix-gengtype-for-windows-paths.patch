From 8d5fdb498502987becb6977fa6c7fa2b257dd9f1 Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sun, 28 Mar 2021 14:00:25 +0200
Subject: [PATCH 01/17] Fix gengtype for windows paths

---
 gcc/gengtype.cc | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/gcc/gengtype.cc b/gcc/gengtype.cc
index 7763f40e9ab..6984b3f00ef 100644
--- a/gcc/gengtype.cc
+++ b/gcc/gengtype.cc
@@ -5072,7 +5072,10 @@ parse_program_options (int argc, char **argv)
 	  break;
 	case 'S':		/* --srcdir */
 	  if (optarg)
+	  {
 	    srcdir = optarg;
+	    if( srcdir[1]==':' ) srcdir += 2;
+	  }
 	  else
 	    fatal ("missing source directory");
 	  srcdir_len = strlen (srcdir);
-- 
