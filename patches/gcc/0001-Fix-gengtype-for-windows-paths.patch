From d2f914f07b7004211c1c84362ce47aa77f1536f7 Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sun, 28 Mar 2021 14:00:25 +0200
Subject: [PATCH 01/17] Fix gengtype for windows paths

---
 gcc/gengtype.cc | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/gcc/gengtype.cc b/gcc/gengtype.cc
index 386ae1b0506..5a7c68ca108 100644
--- a/gcc/gengtype.cc
+++ b/gcc/gengtype.cc
@@ -5087,7 +5087,10 @@ parse_program_options (int argc, char **argv)
 	  break;
 	case 'S':		/* --srcdir */
 	  if (optarg)
+	  {
 	    srcdir = optarg;
+	    if( srcdir[1]==':' ) srcdir += 2;
+	  }
 	  else
 	    fatal ("missing source directory");
 	  srcdir_len = strlen (srcdir);
-- 
