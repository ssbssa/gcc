From f7d013622a767e4ee2a994830dfeae99cd9b1bda Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sun, 28 Mar 2021 14:00:25 +0200
Subject: [PATCH 01/17] Fix gengtype for windows paths

---
 gcc/gengtype.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/gcc/gengtype.c b/gcc/gengtype.c
index 981577481af..50c5093571e 100644
--- a/gcc/gengtype.c
+++ b/gcc/gengtype.c
@@ -5036,7 +5036,10 @@ parse_program_options (int argc, char **argv)
 	  break;
 	case 'S':		/* --srcdir */
 	  if (optarg)
+	  {
 	    srcdir = optarg;
+	    if( srcdir[1]==':' ) srcdir += 2;
+	  }
 	  else
 	    fatal ("missing source directory");
 	  srcdir_len = strlen (srcdir);
-- 
