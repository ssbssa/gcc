From 64d76da545d9a8558cf6b1528fccff3bd65a6fae Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Tue, 22 Oct 2024 16:54:46 +0200
Subject: [PATCH 33/36] Intercept _strdup on Windows-gcc builds

---
 libsanitizer/asan/asan_interceptors.cpp | 23 +++++++++++++++++++++++
 libsanitizer/asan/asan_interceptors.h   |  6 ++++++
 2 files changed, 29 insertions(+)

diff --git a/libsanitizer/asan/asan_interceptors.cpp b/libsanitizer/asan/asan_interceptors.cpp
index 635546b525c..5d7ca72da55 100644
--- a/libsanitizer/asan/asan_interceptors.cpp
+++ b/libsanitizer/asan/asan_interceptors.cpp
@@ -583,6 +583,26 @@ INTERCEPTOR(char*, strdup, const char *s) {
   return reinterpret_cast<char*>(new_mem);
 }
 
+#if ASAN_INTERCEPT__STRDUP
+INTERCEPTOR(char*, _strdup, const char *s) {
+  void *ctx;
+  ASAN_INTERCEPTOR_ENTER(ctx, strdup);
+  if (UNLIKELY(!AsanInited()))
+    return internal_strdup(s);
+  ENSURE_ASAN_INITED();
+  uptr length = internal_strlen(s);
+  if (flags()->replace_str) {
+    ASAN_READ_RANGE(ctx, s, length + 1);
+  }
+  GET_STACK_TRACE_MALLOC;
+  void *new_mem = asan_malloc(length + 1, &stack);
+  if (new_mem) {
+    REAL(memcpy)(new_mem, s, length + 1);
+  }
+  return reinterpret_cast<char*>(new_mem);
+}
+#endif // ASAN_INTERCEPT__STRDUP
+
 #if ASAN_INTERCEPT___STRDUP
 INTERCEPTOR(char*, __strdup, const char *s) {
   void *ctx;
@@ -773,6 +793,9 @@ void InitializeAsanInterceptors() {
   ASAN_INTERCEPT_FUNC(strncat);
   ASAN_INTERCEPT_FUNC(strncpy);
   ASAN_INTERCEPT_FUNC(strdup);
+#if ASAN_INTERCEPT__STRDUP
+  ASAN_INTERCEPT_FUNC(_strdup);
+#endif
 #if ASAN_INTERCEPT___STRDUP
   ASAN_INTERCEPT_FUNC(__strdup);
 #endif
diff --git a/libsanitizer/asan/asan_interceptors.h b/libsanitizer/asan/asan_interceptors.h
index 68b0abe5e8b..bc3356166de 100644
--- a/libsanitizer/asan/asan_interceptors.h
+++ b/libsanitizer/asan/asan_interceptors.h
@@ -110,6 +110,12 @@ void InitializePlatformInterceptors();
 # define ASAN_INTERCEPT_ATEXIT 0
 #endif
 
+#if SANITIZER_WINDOWS && defined(__GNUC__)
+# define ASAN_INTERCEPT__STRDUP 1
+#else
+# define ASAN_INTERCEPT__STRDUP 0
+#endif
+
 #if SANITIZER_GLIBC
 # define ASAN_INTERCEPT___STRDUP 1
 #else
-- 
2.39.1.windows.1

