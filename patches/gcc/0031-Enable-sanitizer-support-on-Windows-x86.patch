diff --git a/libsanitizer/interception/Makefile.in b/libsanitizer/interception/Makefile.in
index 2d807c98d3b..d1209b14be6 100644
--- a/libsanitizer/interception/Makefile.in
+++ b/libsanitizer/interception/Makefile.in
@@ -337,9 +337,10 @@ AM_CPPFLAGS = -I $(top_srcdir)/include -I $(top_srcdir)
 
 # May be used by toolexeclibdir.
 gcc_version := $(shell @get_gcc_base_ver@ $(top_srcdir)/../gcc/BASE-VER)
+omit_frame_pointer = $(if $(filter i686-mingw32,$(target_cpu)-$(target_os)),-fno-omit-frame-pointer,-fomit-frame-pointer)
 AM_CXXFLAGS = -Wall -W -Wno-unused-parameter -Wwrite-strings -pedantic \
 	-Wno-long-long -fPIC -fno-builtin -fno-exceptions -fno-rtti \
-	-fomit-frame-pointer -funwind-tables -fvisibility=hidden \
