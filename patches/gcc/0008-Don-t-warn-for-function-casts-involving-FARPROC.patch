From c2e32cb649eb5eb0ed266003bcdfa9e11255d31d Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sun, 28 Mar 2021 14:35:56 +0200
Subject: [PATCH 08/15] Don't warn for function casts involving FARPROC

---
 gcc/c/c-typeck.c | 5 +++++
 gcc/cp/typeck.c  | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/gcc/c/c-typeck.c b/gcc/c/c-typeck.c
index b5d139e5d9b..2a75cdb84ac 100644
--- a/gcc/c/c-typeck.c
+++ b/gcc/c/c-typeck.c
@@ -5867,6 +5867,11 @@ c_safe_function_type_cast_p (tree t1, tree t2)
       TYPE_ARG_TYPES (t2) == void_list_node)
     return true;
 
+  /* FARPROC  */
+  if (TREE_CODE (TYPE_MAIN_VARIANT (TREE_TYPE (t2))) == INTEGER_TYPE &&
+      TYPE_ARG_TYPES (t2) == NULL_TREE)
+    return true;
+
   if (!c_safe_arg_type_equiv_p (TREE_TYPE (t1), TREE_TYPE (t2)))
     return false;
 
diff --git a/gcc/cp/typeck.c b/gcc/cp/typeck.c
index 1b68c53b831..b81a3e278ae 100644
--- a/gcc/cp/typeck.c
+++ b/gcc/cp/typeck.c
@@ -1249,6 +1249,11 @@ cxx_safe_function_type_cast_p (tree t1, tree t2)
       TYPE_ARG_TYPES (t2) == void_list_node)
     return true;
 
+  /* FARPROC  */
+  if (TREE_CODE (TYPE_MAIN_VARIANT (TREE_TYPE (t2))) == INTEGER_TYPE &&
+      TYPE_ARG_TYPES (t2) == void_list_node)
+    return true;
+
   if (!cxx_safe_arg_type_equiv_p (TREE_TYPE (t1), TREE_TYPE (t2)))
     return false;
 
-- 
