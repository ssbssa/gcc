From f27c2c254dd368c651ae3be78500e64bd52176da Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sun, 28 Mar 2021 14:35:56 +0200
Subject: [PATCH 08/17] Don't warn for function casts involving FARPROC

---
 gcc/c/c-typeck.c | 5 +++++
 gcc/cp/typeck.c  | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/gcc/c/c-typeck.c b/gcc/c/c-typeck.c
index 9342d3a071a..8c6c88fd4a2 100644
--- a/gcc/c/c-typeck.c
+++ b/gcc/c/c-typeck.c
@@ -5764,6 +5764,11 @@ c_safe_function_type_cast_p (tree t1, tree t2)
       TYPE_ARG_TYPES (t2) == void_list_node)
     return true;
 
+  /* FARPROC  */
+  if (TREE_CODE (TYPE_MAIN_VARIANT (TREE_TYPE (t2))) == INTEGER_TYPE &&
+      TYPE_ARG_TYPES (t2) == NULL_TREE)
+    return true;
+
   if (!c_safe_arg_type_equiv_p (TREE_TYPE (t1), TREE_TYPE (t2)))
     return false;
 
diff --git a/gcc/cp/typeck.c b/gcc/cp/typeck.c
index 6ebf6319efd..97c95af363b 100644
--- a/gcc/cp/typeck.c
+++ b/gcc/cp/typeck.c
@@ -1221,6 +1221,11 @@ cxx_safe_function_type_cast_p (tree t1, tree t2)
       TYPE_ARG_TYPES (t2) == void_list_node)
     return true;
 
+  /* FARPROC  */
+  if (TREE_CODE (TYPE_MAIN_VARIANT (TREE_TYPE (t2))) == INTEGER_TYPE &&
+      TYPE_ARG_TYPES (t2) == void_list_node)
+    return true;
+
   if (!cxx_safe_arg_type_equiv_p (TREE_TYPE (t1), TREE_TYPE (t2)))
     return false;
 
-- 
