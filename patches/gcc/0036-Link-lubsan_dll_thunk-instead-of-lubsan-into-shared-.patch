From 7236080df5333dfac72b4dfd259a6c3ad75056c1 Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sun, 27 Oct 2024 17:16:24 +0100
Subject: [PATCH 36/36] Link -lubsan_dll_thunk instead of -lubsan into shared
 targets

---
 gcc/gcc.cc                                    |  3 +-
 libsanitizer/asan/asan_interface.inc          | 25 +++++++++++
 .../sanitizer_common_interface.inc            | 23 ----------
 libsanitizer/ubsan/Makefile.am                |  9 +++-
 libsanitizer/ubsan/Makefile.in                | 43 ++++++++++++++++++-
 libsanitizer/ubsan/ubsan_init.cpp             |  4 ++
 6 files changed, 80 insertions(+), 27 deletions(-)

diff --git a/gcc/gcc.cc b/gcc/gcc.cc
index 2eb745e70a7..0f269c04050 100644
--- a/gcc/gcc.cc
+++ b/gcc/gcc.cc
@@ -839,7 +839,8 @@ proper position among the other output files.  */
   " %{static-libubsan|static:%:include(libsanitizer.spec)%(link_libubsan)}"
 #ifdef HAVE_LD_STATIC_DYNAMIC
 #define LIBUBSAN_SPEC "%{static-libubsan:" LD_STATIC_OPTION \
-		     "} -lubsan -lstdc++ %{static-libubsan:" LD_DYNAMIC_OPTION "}" \
+		     "} %{shared:-lubsan_dll_thunk;:-lubsan -lstdc++}" \
+		     " %{static-libubsan:" LD_DYNAMIC_OPTION "}" \
 		     STATIC_LIBUBSAN_LIBS
 #else
 #define LIBUBSAN_SPEC "-lubsan" STATIC_LIBUBSAN_LIBS
