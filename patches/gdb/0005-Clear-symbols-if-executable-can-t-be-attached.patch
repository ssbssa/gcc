From 9886f7da826553ce346912fa71db19a5fb260beb Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Tue, 4 Mar 2014 20:11:21 +0100
Subject: [PATCH 05/19] Clear symbols if executable can't be attached

---
 gdb/exec.c | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/gdb/exec.c b/gdb/exec.c
index 3dfc437..a3a4561 100644
--- a/gdb/exec.c
+++ b/gdb/exec.c
@@ -174,6 +174,12 @@ exec_file_locate_attach (int pid, int from_tty)
   symbol_file_add_main (full_exec_path, from_tty);
 }
 
+static void
+symbol_file_clear_cleanup (void *ignore)
+{
+  symbol_file_clear (0);
+}
+
 /* Set FILENAME as the new exec file.
 
    This function is intended to be behave essentially the same
@@ -221,6 +227,11 @@ exec_file_attach (const char *filename, int from_tty)
       int scratch_chan;
       struct target_section *sections = NULL, *sections_end = NULL;
       char **matching;
+      struct cleanup *symbol_cleanup;
+      struct cleanup *cleanups_free;
+
+      /* Clear symbols if executable can't be attached.  */
+      symbol_cleanup = make_cleanup (symbol_file_clear_cleanup, 0);
 
       if (is_target_filename (filename))
 	{
@@ -239,7 +250,7 @@ exec_file_attach (const char *filename, int from_tty)
 		     TARGET_SYSROOT_PREFIX);
 
 	  scratch_pathname = xstrdup (filename);
-	  make_cleanup (xfree, scratch_pathname);
+	  cleanups_free = make_cleanup (xfree, scratch_pathname);
 
 	  scratch_chan = -1;
 
@@ -267,7 +278,7 @@ exec_file_attach (const char *filename, int from_tty)
 	  if (scratch_chan < 0)
 	    perror_with_name (filename);
 
-	  make_cleanup (xfree, scratch_pathname);
+	  cleanups_free = make_cleanup (xfree, scratch_pathname);
 
 	  /* gdb_bfd_open (and its variants) prefers canonicalized
 	     pathname for better BFD caching.  */
@@ -329,6 +340,9 @@ exec_file_attach (const char *filename, int from_tty)
       /* Tell display code (if any) about the changed file name.  */
       if (deprecated_exec_file_display_hook)
 	(*deprecated_exec_file_display_hook) (filename);
+
+      do_cleanups (cleanups_free);
+      discard_cleanups (symbol_cleanup);
     }
 
   do_cleanups (cleanups);
-- 
