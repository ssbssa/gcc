From 039d1ef122ba029e2870060855e44856008f169c Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Thu, 12 Feb 2015 17:45:48 +0100
Subject: [PATCH 16/23] Fix highlight colors for empty source window

---
 gdb/tui/tui-source.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/gdb/tui/tui-source.c b/gdb/tui/tui-source.c
index 7282b0758e..76281bfb74 100644
--- a/gdb/tui/tui-source.c
+++ b/gdb/tui/tui-source.c
@@ -899,8 +899,13 @@ tui_set_source_content_nil (struct tui_win_info *win_info,
 	  for (i = xpos + warning_length; i < line_width; i++)
 	    src_line[i] = ' ';
 
-	  src_line[i] = '\n';
+	  src_line[i] = (char) 0;
 
+#ifdef TUI_SYNTAX_HIGHLIGHT
+	  memset (src_line + line_width, 0, line_width);
+	  src_line[line_width + xpos] = COL_LITERAL;
+	  src_line[line_width + xpos + warning_length - 1] = COL_LITERAL;
+#endif
 	}			/* end if */
 
       curr_line++;
-- 
