From 8d4281399c64f9076a52c2fadf2a1cfc45d06740 Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Wed, 5 Nov 2014 19:58:33 +0100
Subject: [PATCH 07/19] Use %USERPROFILE% as alternative to %HOME%

---
 gdb/main.c        | 4 ++++
 gdb/windows-nat.c | 4 ++++
 readline/tilde.c  | 5 +++++
 3 files changed, 13 insertions(+)

diff --git a/gdb/main.c b/gdb/main.c
index aecd60a..7ad9a6d 100644
--- a/gdb/main.c
+++ b/gdb/main.c
@@ -248,6 +248,10 @@ get_init_files (const char **system_gdbinit,
 	}
 
       homedir = getenv ("HOME");
+#ifdef __MINGW32__
+      if (!homedir)
+	homedir = getenv ("USERPROFILE");
+#endif
 
       /* If the .gdbinit file in the current directory is the same as
 	 the $HOME/.gdbinit file, it should not be sourced.  homebuf
diff --git a/gdb/windows-nat.c b/gdb/windows-nat.c
index c097cf9..911cc20 100644
--- a/gdb/windows-nat.c
+++ b/gdb/windows-nat.c
@@ -2773,6 +2773,10 @@ _initialize_check_for_gdb_ini (void)
     return;
 
   homedir = getenv ("HOME");
+#ifdef __MINGW32__
+  if (!homedir)
+    homedir = getenv ("USERPROFILE");
+#endif
   if (homedir)
     {
       char *p;
diff --git a/readline/tilde.c b/readline/tilde.c
index 1c53a45..252b221 100644
--- a/readline/tilde.c
+++ b/readline/tilde.c
@@ -366,6 +366,11 @@ tilde_expand_word (filename)
       if (expansion == 0)
 	expansion = sh_get_home_dir ();
 
+#ifdef __MINGW32__
+      if (expansion == 0)
+	expansion = getenv ("USERPROFILE");
+#endif
+
       return (glue_prefix_and_suffix (expansion, filename, 1));
     }
 
